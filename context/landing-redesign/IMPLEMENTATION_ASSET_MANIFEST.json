{
  "prepared": "2026-10-09",
  "scope": "Reviewed assets for the SciencePeaks landing implementation. Context archives and internal reference captures are excluded from the static export.",
  "product_examples": {
    "activity-week.webp": "Founder-supplied anonymous technical record; acceleration is observed and activity intensity is estimated.",
    "activity-rhythm.webp": "Founder-supplied anonymous technical record; ENMO wrist-movement heatmap.",
    "night-profile.webp": "Anonymous nocturnal DFA alpha 1 technical profile; not an RMSSD curve.",
    "oncology-check-in.webp": "Real native UI with deterministic inspection fixtures.",
    "professional-plan.webp": "Real web UI with synthetic inspection data; minute-based plan.",
    "assistant.webp": "Anonymous cropped, dated assistant demonstration; access is explained in walkthrough.",
    "movement-overview.webp": "Current live app; founder technical activity record, anonymous product-panel crop; Bars show estimated moderate-or-higher minutes. The line below shows wrist movement through the selected day.",
    "movement-week.webp": "Current live app; founder technical activity record, anonymous weekly-panel crop; Estimated activity minutes by day.",
    "movement-day.webp": "Current live app; founder technical activity record, anonymous day-detail crop; The ENMO trace shows wrist movement within the day, in milligrams.",
    "hrv-timeline.webp": "Current live app; founder technical physiological record, anonymous RMSSD timeline crop; Each point is a nightly RMSSD summary. The shaded band shows the personal reference range.",
    "movement-rhythm.webp": "Current live app; founder technical acceleration record, anonymous hourly-heatmap crop; Rows are days; columns are hours. Brighter cells mean greater average wrist movement.",
    "movement-intensity.webp": "Current live app; founder technical activity record, anonymous intensity/pattern panels; Time in estimated intensity bands and the hourly pattern of active movement.",
    "rmssd-night.webp": "Founder personal technical product record; anonymous complete RMSSD panel crop; Product example. RMSSD variation across the observed night, with valid-window count and recording interval.",
    "oncology-check-in-native.webp": "Real native product UI, deterministic oncology demonstration records; Demonstration with synthetic data. A short symptom check-in sits alongside the next treatment and the week’s check-ins.",
    "oncology-treatment-calendar.webp": "Real web product UI in explicit oncology DEMO, synthetic treatments and Alex Morgan inspection identity; Demonstration with synthetic data. The treatment calendar preserves scheduled dates and the selected day’s treatment status.",
    "professional-group-overview.webp": "Real web professional cohort product UI using deterministic development inspection fixtures; nine synthetic participants; Demonstration with synthetic data. A professional review table connects each participant’s RMSSD trend, usable nights and model status.",
    "assistant-answer-evidence.webp": "Dated restricted assistant product demonstration; anonymous visible output, underlying record origin not established; Product demonstration. A natural-language answer is accompanied by calculation, date-window, coverage and source details."
  },
